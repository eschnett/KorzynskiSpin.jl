Cell["\<\
(Power(Sin(\[Theta]),2)*(Power(r,5) + Power(a,4)*r*Power(Cos(\[Theta]),4) + 
       Power(a,2)*r*(Power(Q,2) - M*r)*Power(Sin(\[Theta]),2) + 
       Power(Cos(\[Theta]),2)*(2*Power(a,2)*Power(r,3) + \
Power(a,4)*M*Power(Sin(\[Theta]),2)))*
     (((Power(a,2) + Power(r,2))*(Power(Q,2) - 2*M*r + Power(r,2)) + 
          Power(a,2)*(Power(a,2) + Power(r,2))*Power(Cos(\[Theta]),2) - 
          Power(a,2)*(Power(Q,2) - 2*M*r)*Power(Sin(\[Theta]),2))/
        Sqrt(((-Power(a,2) - Power(r,2) + Power(a,2)*Power(Sin(\[Theta]),2))*
            (Power(r,2)*(Power(a,2) + Power(r,2)) + 
              Power(a,2)*(Power(a,2) + Power(r,2))*Power(Cos(\[Theta]),2) - 
              Power(a,2)*(Power(Q,2) - 2*M*r)*Power(Sin(\[Theta]),2)))/
          (Power(Q,2) - r*(2*M + r) - Power(a,2)*Power(Cos(\[Theta]),2))) - 
       (Power(Q,2) - 2*M*r)*(-(Sqrt(Power(r,2) + \
Power(a,2)*Power(Cos(\[Theta]),2))/
             Sqrt(-Power(Q,2) + 2*M*r + Power(r,2) + Power(a,2)*Power(Cos(\
\[Theta]),2))) + 
          (Power(Q,2) - 2*M*r)/
           ((Power(Q,2) - r*(2*M + r) - Power(a,2)*Power(Cos(\[Theta]),2))*
             Sqrt((-(Power(r,2)*(Power(a,2) + Power(r,2))) - 
                 Power(a,2)*(Power(a,2) + Power(r,2))*Power(Cos(\[Theta]),2) + 
                 Power(a,2)*(Power(Q,2) - 2*M*r)*Power(Sin(\[Theta]),2))/
               ((Power(Q,2) - r*(2*M + r) - Power(a,2)*Power(Cos(\[Theta]),2))*
                 (Power(a,2) + Power(r,2) - \
Power(a,2)*Power(Sin(\[Theta]),2))))))))/
   (Sqrt(2)*Power(Power(r,2) + Power(a,2)*Power(Cos(\[Theta]),2),3))\
\>", "Output",
