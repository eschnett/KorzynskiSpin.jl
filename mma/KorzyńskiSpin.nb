r)))*Power(Sin(\[Theta]),2) + 
            Power(a,6)*M*Power(Sin(\[Theta]),4)) + 
         r*((Power(Q,2) - M*r)*Power(Power(a,2) + Power(r,2),2) + 
            Power(a,2)*(Power(Q,4) - 4*Power(Q,2)*r*(M + r) - 
               2*Power(a,2)*(Power(Q,2) - M*r) + 
               Power(r,2)*(4*Power(M,2) + 6*M*r + Power(r,2)))*Power(Sin(\
\[Theta]),2) + 
            Power(a,4)*(Power(Q,2) - M*r)*Power(Sin(\[Theta]),4)))/
       (Sqrt(2)*(Power(Q,2) - r*(2*M + r) - Power(a,2)*Power(Cos(\[Theta]),2))*
