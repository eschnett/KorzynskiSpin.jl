      ((((Power(a,2) + Power(r,2))*(Power(Q,2) - 2*M*r + Power(r,2)) + 
              Power(a,2)*(Power(a,2) + Power(r,2))*Power(Cos(\[Theta]),2) - 
              Power(a,2)*(Power(Q,2) - 2*M*r)*Power(Sin(\[Theta]),2))/
            Sqrt(((-Power(a,2) - Power(r,2) + \
